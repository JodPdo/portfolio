# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw PO-delivered image sources (multi-MB working files, never shipped).
# Processed outputs live in /public/media/. Explicit filenames on purpose —
# public/images/ also holds tracked, small, processed assets that MUST ship
# (displacement-map.png, jod-hero-duotone.webp, jod-working-duotone.webp).
/public/images/player_style_ref.png
/public/images/jpd_api.png

# raw certificate sources (working files, never shipped) — architect ruling 2026-07-26
/docs/assets/certs/
